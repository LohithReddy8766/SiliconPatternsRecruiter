# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# The Supabase connection is fixed in src/config.js, not env-configurable —
# see that file if the project ever needs to point elsewhere.

# Apify API token, used to run the LinkedIn profile-search actor
# (harvestapi~linkedin-profile-search). Get one at apify.com > Settings > Integrations.
# Optional here — can also be set per-browser via the in-app Settings modal.
VITE_APIFY_API_TOKEN=your-apify-api-token

# Groq API key, used for JD parsing, AI candidate screening, and
# outreach message generation. Get one at console.groq.com/keys.
# Optional here — can also be set per-browser via the in-app Settings modal.
VITE_GROQ_API_TOKEN=your-groq-api-key

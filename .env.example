# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project URL and public anon key (Project Settings > API).
# The anon key is safe to ship to the client ONLY because Row Level
# Security policies (see supabase-rls-setup.sql) are the real access
# control — this app has no backend, so RLS is the actual security
# boundary, not this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Apify API token, used to run the LinkedIn profile-search actor
# (harvestapi~linkedin-profile-search). Get one at apify.com > Settings > Integrations.
VITE_APIFY_API_TOKEN=your-apify-api-token

# Groq API key, used for JD parsing, AI candidate screening, and
# outreach message generation. Get one at console.groq.com/keys.
VITE_GROQ_API_TOKEN=your-groq-api-key
